# WalGerrit payload block for containers/criteo-images/images/33-gerrit/Dockerfile.
#
# Publish gerrit.war and walgerrit.jar from the verified GitHub Actions payload to an approved
# internal Nexus Maven or Raw repository first. Pin immutable URLs and SHA-256 values here.
# Do not use a GitHub Actions artifact URL: it is authenticated and expires.
ARG WALGERRIT_WAR_URL
ARG WALGERRIT_WAR_SHA256
ARG WALGERRIT_JAR_URL
ARG WALGERRIT_JAR_SHA256

RUN set -eux; \
    test -n "$WALGERRIT_WAR_URL"; \
    test -n "$WALGERRIT_WAR_SHA256"; \
    test -n "$WALGERRIT_JAR_URL"; \
    test -n "$WALGERRIT_JAR_SHA256"; \
    curl -fSL "$WALGERRIT_WAR_URL" -o /home/gerrit/gerrit.war; \
    echo "$WALGERRIT_WAR_SHA256  /home/gerrit/gerrit.war" | sha256sum -c -; \
    mkdir -p /opt/gerrit/lib; \
    curl -fSL "$WALGERRIT_JAR_URL" -o /opt/gerrit/lib/walgerrit.jar; \
    echo "$WALGERRIT_JAR_SHA256  /opt/gerrit/lib/walgerrit.jar" | sha256sum -c -

# Remove the stock Gerrit 3.12.2 WAR download/checksum block. The final file at
# /home/gerrit/gerrit.war is the server that the Gerrit PoC entrypoint runs.
